{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    // The tokens package is built for consumers; inside the monorepo its source
    // is the truth, so typecheck and tests do not depend on a prior build.
    "baseUrl": ".",
    "paths": {
      "glacia-tokens": ["../tokens/src/index.ts"]
    }
  },
  "include": ["src", "test"],
  // The vendored glass engine (src/engine) ships as source for Metro and is
  // consumed through the runtime module loader; it is built by the engine's own
  // toolchain, so it is not part of this package's compilation.
  "exclude": ["src/engine"]
}
