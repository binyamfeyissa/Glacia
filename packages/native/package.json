{
  "name": "glacia-native",
  "version": "0.6.7",
  "description": "Liquid Glass UI components for React Native \u2014 real iOS 26 glass, with a clean fallback on Android and older iOS.",
  "author": "Binyam Feyissa (https://github.com/binyamfeyissa)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binyamfeyissa/Glacia.git",
    "directory": "packages/native"
  },
  "homepage": "https://github.com/binyamfeyissa/Glacia#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "lib",
    "src",
    "expo-module.config.json"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "expo": "*",
    "react": ">=18",
    "react-native": ">=0.80",
    "react-native-gesture-handler": ">=2.20.0",
    "react-native-reanimated": ">=3.16.0",
    "react-native-svg": ">=13",
    "expo-blur": ">=12",
    "@react-native-community/blur": ">=4"
  },
  "dependencies": {
    "glacia-tokens": "0.5.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-native-svg": "^15.16.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "react-native-svg": {
      "optional": true
    },
    "expo-blur": {
      "optional": true
    },
    "@react-native-community/blur": {
      "optional": true
    }
  }
}
