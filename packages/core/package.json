{
  "name": "glacia",
  "version": "0.3.4",
  "description": "Liquid Glass UI components for React — real refraction on the web, with its own copy command (npx glacia add) and a React Native companion.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binyamfeyissa/Glacia.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/binyamfeyissa/Glacia#readme",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "glacia": "./bin/cli.js"
  },
  "sideEffects": [
    "*.css",
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./internal/*": {
      "import": {
        "types": "./dist/internal/*.d.ts",
        "default": "./dist/internal/*.js"
      },
      "require": {
        "types": "./dist/internal/*.d.cts",
        "default": "./dist/internal/*.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "registry"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "glacia-tokens": "workspace:*",
    "radix-ui": "^1.8.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.33.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.2",
    "typescript": "^5.7.3",
    "unrun": "^0.3.1",
    "vitest": "^3.0.0"
  }
}
